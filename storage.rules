rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Fotografias de utilizadores e utentes
    match /{pasta}/{ficheiro} {
      allow read: if request.auth != null && pasta in ['users', 'utentes'];
      allow write: if request.auth != null
        && pasta in ['users', 'utentes']
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
