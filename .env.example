# Copie para .env e preencha. Estes valores são públicos (vão no bundle da app);
# segredos ficam apenas em backend/.env.

# URL do backend (pasta backend/). No telemóvel use o IP da sua máquina na rede local,
# por exemplo http://192.168.1.10:3000 — "localhost" só funciona no emulador web.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Stream Chat: chave pública (https://dashboard.getstream.io)
EXPO_PUBLIC_STREAM_API_KEY=

# Firebase: Consola > Definições do projeto > As suas apps > Configuração do SDK
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
