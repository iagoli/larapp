PORT=3000

# Chaves do Stream Chat (https://dashboard.getstream.io)
STREAM_API_KEY=
STREAM_API_SECRET=

# Caminho para a chave de conta de serviço do Firebase
# (Consola Firebase > Definições do projeto > Contas de serviço > Gerar nova chave privada)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Palavra-passe das contas criadas por "npm run seed" (opcional; por omissão "larapp-demo")
SEED_PASSWORD=
